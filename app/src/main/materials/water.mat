material {
    name : water,
    shadingModel : lit,
    parameters : [
        { type : float3, name : shallowColor },
        { type : float3, name : deepColor },
        { type : float,  name : time }
    ],
    requires : [
        position
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // Two slow interference bands over world XZ: flat-color shimmer, no textures.
        float2 p = getWorldPosition().xz;
        float w = sin(dot(p, float2(1.7, 2.3)) + materialParams.time * 0.9)
                * sin(dot(p, float2(-2.1, 1.3)) + materialParams.time * 0.6);
        float t = 0.5 + 0.5 * w;
        material.baseColor.rgb = mix(materialParams.shallowColor, materialParams.deepColor, t * 0.45);
        material.roughness = 0.55;
        material.metallic = 0.0;
    }
}
